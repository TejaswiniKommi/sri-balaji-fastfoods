# Base URL of your existing Spring Boot backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# true  = use sample menu data in src/data/menu.mock.js
# false = call GET/POST/PUT/DELETE /api/foods on your Spring Boot backend
VITE_USE_MOCK=true

# true  = orders are simulated in the browser (your order API is not ready yet)
# false = POST /api/orders on your Spring Boot backend
VITE_USE_MOCK_ORDERS=true

# Delivery fee in rupees. 0 until you decide a fee.
VITE_DELIVERY_FEE=0
